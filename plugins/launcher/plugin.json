{
  "id": "launcher",
  "name": "快捷启动",
  "version": "0.1.0",
  "description": "搜索并打开应用，以及收藏的文件、文件夹",
  "searchProvider": true,
  "features": [
    {
      "code": "manage",
      "explain": "管理收藏的路径",
      "cmds": ["收藏", "快捷启动", "launcher", "bookmark"],
      "match": { "files": ["*"], "maxFiles": 1 }
    },
    {
      "code": "copy-path",
      "explain": "复制文件路径",
      "cmds": ["复制路径"],
      "match": { "files": ["*"] }
    },
    {
      "code": "copy-name",
      "explain": "提取文件名称",
      "cmds": ["提取文件名"],
      "match": { "files": ["*"] }
    }
  ]
}
