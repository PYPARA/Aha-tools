{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AhaTools",
  "version": "0.1.0",
  "identifier": "com.ahatools.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "AhaTools",
        "width": 760,
        "height": 500,
        "decorations": false,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
